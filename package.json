{
  "name": "kadanglabo-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.worker.json && vite build",
    "preview": "vite preview",
    "preview:worker": "npm run build && wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "img": "node scripts/optimize-image.mjs",
    "test:cms": "node scripts/test-cms-integration.mjs && node scripts/test-cms-lifecycle.mjs && node scripts/test-article-canvas.mjs",
    "test:cms:browser": "node scripts/test-cms-browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "1.65.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.160.0"
  }
}
