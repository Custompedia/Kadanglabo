{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kadanglabo-website",
  "main": "worker/public.ts",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // only the CMS routes reach the Worker; every page and file is served straight from the assets
    "run_worker_first": ["/api/*", "/media/*"]
  },
  // The CMS's databases and image bucket, read-only from here. The ids must be the same as in admin/wrangler.jsonc.
  "d1_databases": [
    { "binding": "CONTENT_DB", "database_name": "kadanglabo-content", "database_id": "00000000-0000-0000-0000-00000000c001" },
    { "binding": "MEDIA_DB", "database_name": "kadanglabo-media", "database_id": "00000000-0000-0000-0000-00000000e001" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kadanglabo-media" }]
}
