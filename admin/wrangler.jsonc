{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Kadanglabo CMS: the dashboard (static SPA) and its API, at admin.kadanglabo.com.
  "name": "kadanglabo-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  // One database per concern, so none of them carries the others' weight (and auth stays apart from content).
  // database_id: the production databases (Cloudflare account hello@custompedia.id). preview_database_id keeps local
  // development (npm run dev, --local) on its own local copy, so it never touches production.
  "d1_databases": [
    { "binding": "AUTH_DB", "database_name": "kadanglabo-auth", "database_id": "2ac698b8-99b2-4bec-9388-2595039ad353", "preview_database_id": "00000000-0000-0000-0000-00000000a001", "migrations_dir": "migrations/auth" },
    { "binding": "CONTENT_DB", "database_name": "kadanglabo-content", "database_id": "3d5ac06a-60c8-4dd4-87a5-19f99611f5aa", "preview_database_id": "00000000-0000-0000-0000-00000000c001", "migrations_dir": "migrations/content" },
    { "binding": "MEDIA_DB", "database_name": "kadanglabo-media", "database_id": "c1d35b7d-0004-4442-abf7-b8522db23981", "preview_database_id": "00000000-0000-0000-0000-00000000e001", "migrations_dir": "migrations/media" }
  ],
  // Published image sizes (read by the public site too), and the uploaded originals (private).
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "kadanglabo-media" },
    { "binding": "ORIGINALS", "bucket_name": "kadanglabo-originals" }
  ],
  // Monday 03:00 UTC: remove images unused for a week (worker/media.ts, cleanupMedia)
  "triggers": { "crons": ["0 3 * * 1"] },
  "vars": {
    "PUBLIC_SITE_URL": "https://kadanglabo.com",
    // ArticleFlow (admin/articleflow): where Custompedia Tech's Partner API lives and this website's id there. The key is
    // a secret (wrangler secret put TECH_PARTNER_KEY). Without the id or the key the page says "belum terhubung".
    "TECH_API_URL": "https://content-api.custompedia.id",
    "TECH_SITE_ID": "client-42238789177440b899eb07ad11a99d21"
  }
}
